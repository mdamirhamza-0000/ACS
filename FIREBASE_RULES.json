{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "employees": {
      ".read": "auth != null && auth.token.email === 'avrok.ac.services.01@gmail.com' && auth.token.email_verified === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.token.email === 'avrok.ac.services.01@gmail.com' && auth.token.email_verified === true"
      }
    },
    "serviceOrders": {
      ".read": "auth != null && ((auth.token.email === 'avrok.ac.services.01@gmail.com' && auth.token.email_verified === true) || root.child('employees').child(auth.uid).child('active').val() === true)",
      "$orderId": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && ((auth.token.email === 'avrok.ac.services.01@gmail.com' && auth.token.email_verified === true) || root.child('employees').child(auth.uid).child('active').val() === true))",
        ".validate": "newData.hasChildren(['name','service','status','createdAt'])",
        "name":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "phone":     { ".validate": "newData.isString() && newData.val().length <= 20" },
        "service":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "message":   { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "source":    { ".validate": "newData.isString() && newData.val().length <= 100" },
        "status":    { ".validate": "newData.isString() && (newData.val() === 'new' || (auth != null && newData.val() === 'done' && ((auth.token.email === 'avrok.ac.services.01@gmail.com' && auth.token.email_verified === true) || root.child('employees').child(auth.uid).child('active').val() === true)))" },
        "createdAt": { ".validate": "newData.val() === now || newData.val() === data.val()" },
        "lat":       { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lng":       { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "accuracy":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "mapsLink":  { ".validate": "newData.isString() && newData.val().length <= 100 && newData.val().beginsWith('https://www.google.com/maps?q=')" },
        "$other":    { ".validate": false }
      }
    }
  }
}
